PORT=3001
HOST=127.0.0.1
# 32+ байт, hex. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-64-hex-chars-minimum-0000000000000000000000000000
JWT_SECRET=change-me-too
# Лимиты по умолчанию
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_MS=30000
# Auth: первый запуск создаёт users.admin из этих значений. Можно не задавать
# вовсе — тогда вход будет admin / admin, но первый вход упрётся в обязательную
# смену логина и пароля (флаг mustChange). Явно заданный слабый пароль в
# production контейнер не поднимет; встроенный дефолт пропускается именно
# потому, что его нельзя оставить (смена обязательна).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-min-8-chars
REQUIRE_AUTH=1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=200
# Пул и бэкапы
# META_PATH=./data/meta.db  # в compose: /data/meta.db
# SQLite файлы: ./data/sqlite/*.db (100MB лимит)
